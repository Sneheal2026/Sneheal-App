{
  "expo": {
    "name": "SnehealApp",
    "slug": "sneheal-app",
    "version": "0.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sneheal.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Sneheal to use the microphone for voice search.",
        "NSSpeechRecognitionUsageDescription": "Allow Sneheal to use speech recognition for voice search.",
        "NSLocationWhenInUseUsageDescription": "Sneheal uses your location to show your delivery address, nearby pharmacies, and nearest hospitals.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "comgooglemaps",
          "comgooglemaps-x-callback"
        ]
      }
    },
    "android": {
      "package": "com.sneheal.app",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "queries": [
        {
          "package": "com.google.android.apps.maps"
        },
        {
          "intent": {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "google.navigation"
            }
          }
        },
        {
          "intent": {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "https",
              "host": "www.google.com"
            }
          }
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon-48.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Sneheal-Logoo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sneheal to access your photos to upload prescriptions and medicine images.",
          "cameraPermission": "Allow Sneheal to use your camera to photograph prescriptions and medicines."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Sneheal to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow Sneheal to use speech recognition for voice search."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Sneheal to use your location for delivery, maps, and nearest hospitals."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#CA2164",
          "defaultChannel": "medicine-reminders",
          "mode": "production"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "owner": "sneheal-medtech-private-limited",
    "extra": {
      "eas": {
        "projectId": "0ecd72c6-b621-4e90-bbae-2cb584ae8f61"
      }
    }
  }
}
