PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sneheal

JWT_SECRET=change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
OTP_EXPIRES_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Gemini AI for prescription scanning
GEMINI_API_KEY=

# Cloudinary (prescription images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Sneheall

# Razorpay (test keys from dashboard; never put Key Secret in the app)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Optional until a public webhook URL exists (ngrok / production HTTPS)
RAZORPAY_WEBHOOK_SECRET=

# Brevo — ops alert when an order is paid (optional)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Sneheal Orders
BREVO_OPS_EMAIL=
